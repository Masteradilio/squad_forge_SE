# ForgeOS Cloud environment example
# Copy to .env for local development. Do not commit .env.

LOCALFORGE_ENV=development
LOCALFORGE_DB_URL=sqlite:///./.localforge/localforge.sqlite3

# Required by Docker Compose. Replace these values outside disposable use.
POSTGRES_PASSWORD=replace-with-a-long-postgres-password
REDIS_PASSWORD=replace-with-a-long-redis-password
LOCALFORGE_API_TOKEN=replace-with-a-long-api-token
LOCALFORGE_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
LOCALFORGE_SANDBOX_TYPE=docker
LOCALFORGE_SANDBOX_IMAGE=forgeos-sandbox:py312

# All inference goes through OmniRoute. Configure free/freemium upstreams in
# OmniRoute itself; ForgeOS never calls an upstream provider directly.
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# OmniRoute upstream safety bounds. ForgeOS does not call providers directly.
OMNIROUTE_FETCH_TIMEOUT_MS=60000
OMNIROUTE_FETCH_HEADERS_TIMEOUT_MS=30000
OMNIROUTE_FETCH_BODY_TIMEOUT_MS=60000
OMNIROUTE_FETCH_CONNECT_TIMEOUT_MS=10000
OMNIROUTE_PROVIDER_COOLDOWN_ENABLED=true
OMNIROUTE_PROVIDER_COOLDOWN_MIN_MS=5000
OMNIROUTE_PROVIDER_COOLDOWN_MAX_MS=60000
LOCALFORGE_MODEL_BASE_URL=http://localhost:20128/v1
LOCALFORGE_MODEL_API_KEY=
LOCALFORGE_MODEL_PROVIDER=omniroute
LOCALFORGE_DEFAULT_MODEL=auto/best-free
LOCALFORGE_FALLBACK_MODELS=auto/coding:free,auto/best-free
LOCALFORGE_LLM_MAX_OUTPUT_TOKENS=4096
LOCALFORGE_LLM_MAX_INPUT_TOKENS=0
# Structured Chief calls use this smaller ceiling on free/freemium routes.
LOCALFORGE_OMNIROUTE_MAX_OUTPUT_TOKENS=8000
LOCALFORGE_VISUAL_REQUEST_TIMEOUT=60
# OmniRoute free routes use bounded, independently validated visual sections.
LOCALFORGE_VISUAL_SECTION_FALLBACK=true
LOCALFORGE_OMNIROUTE_REASONING_EFFORT=none
# Bound a stalled free/freemium alias before trying the next OmniRoute route.
LOCALFORGE_OMNIROUTE_REQUEST_TIMEOUT=180
# Bound the preflight completion proof before an unattended run starts.
LOCALFORGE_CLOUD_PREFLIGHT_ROUTE_TIMEOUT=15
LOCALFORGE_OMNIROUTE_MAX_ROUTE_PROBES=6

LOCALFORGE_CHIEF_PROVIDER=omniroute
LOCALFORGE_CHIEF_BASE_URL=http://localhost:20128/v1
LOCALFORGE_CHIEF_MODEL=auto/best-free
LOCALFORGE_CHIEF_VISUAL_MODEL=auto/best-free
LOCALFORGE_CHIEF_VISUAL_FALLBACK_MODELS=auto/coding:free,auto/best-free
LOCALFORGE_CHIEF_FALLBACK_MODELS=auto/coding:free,auto/best-free
LOCALFORGE_CHIEF_MAX_ACTIVE_MODEL_CALLS=16
LOCALFORGE_VISUAL_MAX_ACTIVE_MODEL_CALLS=96
LOCALFORGE_CHIEF_API_KEY=

# Dynamic combo mutation is disabled by default. Read-only discovery still
# verifies JSON and tool-use contracts before every Cloud run.
LOCALFORGE_OMNIROUTE_JSON_VERIFIED=true
LOCALFORGE_OMNIROUTE_COMBO_MUTATION_ENABLED=false

# Project and Git overrides.
LOCALFORGE_PROJECT_NAME=
LOCALFORGE_DEFAULT_BRANCH=main
LOCALFORGE_REMOTE_URL=
LOCALFORGE_GITHUB_TOKEN=

CONTEXT7_MCP_URL=https://mcp.context7.ai/v1
FORGEOS_VAULT_KEY=replace-with-a-long-aes256-key

FORGEOS_SEMANTIC_CACHE_ENABLED=true
FORGEOS_CACHE_SIMILARITY_THRESHOLD=0.92
FORGEOS_CACHE_TTL_SECONDS=86400
