# Dockerfile.omniroute - Node.js 22 OmniRoute AI Gateway Proxy
FROM node:22-alpine

WORKDIR /app

# Install git, curl, and bash for healthchecks and discovery routines
RUN apk add --no-cache git curl bash python3 make g++

# Install OmniRoute CLI / proxy gateway
RUN npm install -g omniroute@latest || true

EXPOSE 20128

# Set default environment variables for OmniRoute
ENV PORT=20128
ENV HOST=0.0.0.0
ENV NODE_ENV=production

# Entrypoint script running OmniRoute gateway
CMD ["npx", "omniroute", "start", "--port", "20128", "--host", "0.0.0.0"]
