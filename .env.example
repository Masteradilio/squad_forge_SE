# ForgeOS local configuration template
# Copy this file to .env and replace every placeholder with a local value.
# Never commit .env or real provider/database credentials.

LOCALFORGE_ENV=development
LOCALFORGE_DB_URL=sqlite:///./.localforge/localforge.sqlite3

# Economy-first route for ordinary agent work. Critical work is routed to the
# paid OpenRouter lane below unless LOCALFORGE_CHIEF_PROVIDER is explicit.
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_HOST_PORT=20128
OMNIROUTE_API_KEY=replace-with-your-omniroute-key
LOCALFORGE_MODEL_BASE_URL=http://127.0.0.1:20128/v1
LOCALFORGE_MODEL_API_KEY=replace-with-your-omniroute-key
LOCALFORGE_MODEL_PROVIDER=omniroute
LOCALFORGE_DEFAULT_MODEL=auto/best-free
LOCALFORGE_FALLBACK_MODELS=auto/coding:free,auto/best-free
LOCALFORGE_CHIEF_BASE_URL=http://127.0.0.1:20128/v1
LOCALFORGE_CHIEF_MODEL=auto/best-free
LOCALFORGE_CHIEF_FALLBACK_MODELS=auto/coding:free,auto/best-free
# Increase only when the selected upstream needs more time to emit JSON.
LOCALFORGE_OMNIROUTE_STRUCTURED_TIMEOUT=120

# Optional local project and Git settings.
LOCALFORGE_PROJECT_NAME=
LOCALFORGE_DEFAULT_BRANCH=main
LOCALFORGE_REMOTE_URL=

# Release promotion is human-gated by default. Use full_access only when the
# local target branch and automated post-merge gates are explicitly trusted.
LOCALFORGE_RELEASE_PROMOTION_MODE=human_approval
LOCALFORGE_RELEASE_TARGET_BRANCH=main
LOCALFORGE_RELEASE_TESTER_COMMAND=python -m pytest -q
LOCALFORGE_RELEASE_SECURITY_COMMAND=python scripts/check_security_scans.py
LOCALFORGE_RELEASE_POST_MERGE_TIMEOUT=600
LOCALFORGE_RELEASE_REQUIRE_CLEAN_TARGET=true
# Optional governed profiles: reference, full_coverage, saas.
LOCALFORGE_RELEASE_OPERATIONAL_PROFILES=
LOCALFORGE_RELEASE_REQUIRE_TREE_AUDIT=false
LOCALFORGE_RELEASE_REQUIRE_SEMANTIC_REVIEW=false

# Optional integrations; leave blank unless explicitly configured.
LOCALFORGE_GITHUB_TOKEN=
# The paid lane is the default for Chief Engineer, critical repair and final
# validation. OpenRouter's current alias ID includes the leading '~'.
OPENROUTER_PAID_MODEL=~deepseek/deepseek-v4-flash-latest
# Free direct OpenRouter lane used only after the critical route fails.
OPENROUTER_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
# Deprecated compatibility alias for OPENROUTER_PAID_MODEL.
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
# Direct NVIDIA free lane used as the next bounded fallback.
NVIDIA_LLM_MODEL=minimaxai/minimax-m3
NVIDIA_URL_REFERENCE_MODEL=
NVIDIA_API_KEY=

# Required only for the Docker Compose deployment.
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-local-redis-password
# Host-only port used by local Redis probes; containers use redis:6379.
REDIS_HOST_PORT=6379
LOCALFORGE_API_TOKEN=replace-with-a-local-api-token

# Context7 MCP (optional; obtain a key from Context7 and keep the real value in .env)
CONTEXT7_API_KEY=ctx7sk-your-key-here
CONTEXT7_MCP_ENDPOINT=https://mcp.context7.com/mcp
CONTEXT7_ENABLED=true
CONTEXT7_TIMEOUT=30

# Provider circuit protection. These apply only to transient availability
# failures and do not bypass authentication, billing, or contract errors.
LOCALFORGE_PROVIDER_FAILURE_THRESHOLD=2
LOCALFORGE_PROVIDER_COOLDOWN_SECONDS=60
