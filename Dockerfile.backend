# Dockerfile.backend - Python 3.11 / FastAPI / Playwright / Pgvector Backend
FROM python:3.11-slim

WORKDIR /app

# Prevent Python from writing bytecode and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies, Node.js/npm for tools, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    nodejs \
    npm \
    pkg-config \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml, README.md, LICENSE, and backend code
COPY pyproject.toml README.md LICENSE requirements.txt* uv.lock /app/
COPY backend /app/backend

# Install the reproducible Cloud dependency set.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -e ".[cloud]" && \
    pip install --no-cache-dir pgvector && \
    pip install --no-cache-dir "setuptools>=78.1.1" "msgpack>=1.2.1"

# Do not ship build-environment SBOM fragments from third-party wheels. They
# describe packaging tools used to build a wheel, not the runtime packages,
# and make image scanners report stale duplicate versions.
RUN find /usr/local/lib/python3.11/site-packages -type d -path '*/.dist-info/sboms' -prune -exec rm -rf {} +

# The runtime image does not need pip or ensurepip's bundled build wheels.
# Removing them prevents scanners from inventorying vendored, unused copies of
# packaging libraries alongside the actual application dependencies.
RUN python -m pip uninstall -y pip && \
    rm -rf /usr/local/lib/python3.11/ensurepip/_bundled

# Browser binaries are intentionally opt-in. Downloading Chromium during the
# default backend build makes local/Kubernetes builds depend on a large,
# failure-prone external transfer. Visual benchmark images can opt in with
# --build-arg INSTALL_PLAYWRIGHT_BROWSER=true.
ARG INSTALL_PLAYWRIGHT_BROWSER=false
RUN if [ "$INSTALL_PLAYWRIGHT_BROWSER" = "true" ]; then \
      playwright install chromium; \
    else \
      echo "Skipping Playwright browser binaries (opt-in build argument)."; \
    fi

# Do not run the API as root.  Docker/Podman remains the only execution
# boundary for agent commands when sandbox.type=docker.
RUN useradd --create-home --uid 10001 forgeos && chown -R forgeos:forgeos /app
USER forgeos

COPY .env.example /app/.env.example

EXPOSE 8000

ENV PYTHONPATH=/app/backend

# Default command to run FastAPI app
CMD ["uvicorn", "localforge.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
