# Dockerfile.frontend - Multi-stage build for React 19 / Vite Web App
# Stage 1: Build static assets
FROM node:22-alpine AS build-stage

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Serve via Nginx
FROM nginx:alpine AS production-stage

ENV NGINX_PORT=8080
ENV BACKEND_HOST=backend
ENV LOCALFORGE_TENANT_ID=local
ENV LOCALFORGE_USER_ID=local-user
ENV LOCALFORGE_TENANT_ROLES=owner

COPY --from=build-stage /app/dist /usr/share/nginx/html

# Use the official Nginx entrypoint template so the browser never receives the
# API token while the internal proxy can authenticate requests to the backend.
COPY docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template

RUN rm -f /etc/nginx/conf.d/default.conf \
    && sed -i 's|^pid[[:space:]].*;|pid        /var/run/nginx.pid;|' /etc/nginx/nginx.conf \
    && mkdir -p /var/cache/nginx /var/run /var/log/nginx /etc/nginx/conf.d \
    && chown -R 10100:10100 /var/cache/nginx /var/run /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html

USER 10100

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
