# LocalForge OS environment example
# Copy to .env for local development. Do not commit .env.

LOCALFORGE_ENV=development
LOCALFORGE_DB_URL=sqlite:///./.localforge/localforge.sqlite3

# Ollama/OpenAI-compatible local endpoint
LOCALFORGE_MODEL_BASE_URL=http://localhost:11434/v1/
LOCALFORGE_MODEL_API_KEY=ollama
LOCALFORGE_MODEL_PROVIDER=ollama
LOCALFORGE_DEFAULT_MODEL=llama3

# Optional LocalForge-specific LLM tuning. NUM_CTX is forwarded as
# Ollama ``options.num_ctx`` and controls the model's effective context
# window. The default Ollama server hands out a 2 KiB num_ctx unless
# overridden, which silently caps the local lanes — many of the local
# models LocalForge supports (gemma4 with 32 KiB, granite4.1 with 131
# KiB, nemotron-3-nano with 4 KiB) can use that headroom. Tweak
# MAX_OUTPUT_TOKENS if you observe the NIM free tier collapsing
# otherwise valid JSON Schema responses into ``content: null`` because
# the response ran past the model's default output budget.
LOCALFORGE_LLM_NUM_CTX=32768
LOCALFORGE_LLM_MAX_OUTPUT_TOKENS=4096
LOCALFORGE_LLM_MAX_INPUT_TOKENS=0

# Optional paid Chief Engineer tier through NVIDIA NIM (with OpenRouter
# fallback). Keep the API key only in your local .env, never in tracked
# files. Leave them empty to skip the Chief Engineer lane entirely; the
# demo (samples/demo-lf-smoke-prd/) explicitly pins runtime calls to
# the local lanes via scripts/apply_demo_local_first.py.
NVIDIA_LLM_MODEL=minimaxai/minimax-m3
NVIDIA_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3
OPENROUTER_API_KEY=

# Project and Git Configuration Overrides
LOCALFORGE_PROJECT_NAME=
LOCALFORGE_DEFAULT_BRANCH=main
LOCALFORGE_REMOTE_URL=

# GitHub PR creation is optional and disabled until configured.
LOCALFORGE_GITHUB_TOKEN=

# ForgeOS Cloud OmniRoute & Context7 Configuration
OMNIROUTE_URL=http://localhost:20128/v1
CONTEXT7_MCP_URL=https://mcp.context7.ai/v1
FORGEOS_VAULT_KEY=your-aes256-encryption-key-here
